name = "cloudflare-killswitch"
main = "src/index.ts"
compatibility_date = "2025-01-01"
# Needed only for POST /restore (enableRecoveryWebhook: true).  Otherwise set
# false: the cron runs without it, and a public URL lets anyone spend the
# 100,000/day Workers request quota and push the account towards a kill.
workers_dev = true
preview_urls = false

[triggers]
crons = ["*/5 * * * *"]

# ---------------------------------------------------------------------------
# KV — stores kill-switch state (required)
# Replace the id with your real KV namespace ID from the Cloudflare dashboard:
#   wrangler kv namespace create KILL_SWITCH_STATE
# ---------------------------------------------------------------------------
[[kv_namespaces]]
binding = "KILL_SWITCH_STATE"
id = "REPLACE_ME_WITH_YOUR_KV_NAMESPACE_ID"

# ---------------------------------------------------------------------------
# Rate limiting for POST /restore — RECOMMENDED when enableRecoveryWebhook is true
# Binding name must stay RESTORE_RATE_LIMITER. namespace_id is any positive integer
# string unique in your account. Without it, an in-memory per-isolate limiter is
# used. Needs wrangler 4.36+. Limits are per Cloudflare location (approximate).
# ---------------------------------------------------------------------------
[[ratelimits]]
name = "RESTORE_RATE_LIMITER"
namespace_id = "1001"

  [ratelimits.simple]
  limit = 10
  period = 60

# ---------------------------------------------------------------------------
# Vars (not secret — safe to commit)
# ---------------------------------------------------------------------------
[vars]
# Your Cloudflare account ID
# https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/
CLOUDFLARE_ACCOUNT_ID = "REPLACE_ME_WITH_YOUR_ACCOUNT_ID"

# Your zone ID — required when scope = 'zone' in config.ts
# Leave as placeholder if using scope = 'account' or scope = 'none'
# https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/
CLOUDFLARE_ZONE_ID = "REPLACE_ME_WITH_YOUR_ZONE_ID"

# The name of this Worker script — used to exclude itself when blocking.workers = 'all'.
# Must match the `name` field at the top of this file.
WORKER_SELF_NAME = "cloudflare-killswitch"

# OPTIONAL — the hostname POST /restore is served on, e.g.
# "cloudflare-killswitch.<your-subdomain>.workers.dev".
# When set, the WAF block rule exempts /restore only on this host.  Without it
# the exemption matches POST /restore on every host in the zone, including your
# own origin app.  Only relevant when enableRecoveryWebhook is true.
# RECOVERY_HOSTNAME = "cloudflare-killswitch.example.workers.dev"

# ---------------------------------------------------------------------------
# Secrets — set with `wrangler secret put <NAME>` (never commit these values)
# ---------------------------------------------------------------------------
# wrangler secret put CLOUDFLARE_API_TOKEN
#   Needs permissions depending on your config (run `pnpm run validate` for the exact list):
#     always          -> Account.Account Analytics (Read)
#     scope='zone'    -> Zone.WAF (Edit)
#     scope='account' -> Account.Account WAF (Edit)
#     blocking.workers set -> Account.Workers Scripts (Edit)
#     blocking.pages set   -> Account.Cloudflare Pages (Edit)
#     blocking.r2 set      -> Account.Workers R2 Storage (Edit)
#
# wrangler secret put RECOVERY_SECRET
#   Any strong random string; used as the Bearer token for POST /restore

# ---------------------------------------------------------------------------
# Email alerts — OPTIONAL
# Uncomment the block below AND set EMAIL_FROM / EMAIL_TO only if you want
# email notifications.  Requires Cloudflare Email Routing to be enabled on
# your account with a verified destination address.
# ---------------------------------------------------------------------------
# [[send_email]]
# name = "SEND_EMAIL"
# destination_address = "REPLACE_ME_WITH_DESTINATION_EMAIL"

# [vars] additions for email (add under the existing [vars] section above):
# EMAIL_FROM = "killswitch@yourdomain.com"   # must be a verified sender in Email Routing
# EMAIL_TO   = "you@example.com"             # must match destination_address above

# ---------------------------------------------------------------------------
# Webhook alerts — OPTIONAL, works without a domain or Email Routing
# Set the URL as a SECRET (it is a credential — anyone with it can post to your
# channel), never in [vars]:
#   pnpm exec wrangler secret put ALERT_WEBHOOK_URL
# The payload format is chosen from the host, so no other config is needed:
#   ntfy       https://ntfy.sh/<your-long-random-topic>   (plain text + Title header)
#   Discord    https://discord.com/api/webhooks/<id>/<token>   (JSON, 2000-char cap)
#   Slack      https://hooks.slack.com/services/T000/B000/XXXX   (JSON)
# Any other https URL receives a plain-text POST like ntfy. Must be https.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Observability — persists Worker logs (including console.error from failed
# cron ticks) so they can be read in the dashboard after the fact.
# Workers Logs is available on the Free plan: 200,000 logs/day, 3 days retention
# (Paid: 7 days). https://developers.cloudflare.com/workers/observability/logs/workers-logs/
# ---------------------------------------------------------------------------
[observability]
enabled = true

# ---------------------------------------------------------------------------
# R2 bindings — OPTIONAL, only needed if purgeConfig.r2 is non-empty in config.ts
# Uncomment and duplicate this block for each bucket you want to purge.
# The binding name MUST match purgeConfig.r2[].bindingName in config.ts exactly.
# ---------------------------------------------------------------------------
# [[r2_buckets]]
# binding     = "REPLACE_ME_R2_BINDING"   # e.g. "MY_UPLOADS_BUCKET"
# bucket_name = "your-actual-bucket-name"

# ---------------------------------------------------------------------------
# D1 bindings — OPTIONAL, only needed if purgeConfig.d1 is non-empty in config.ts
# Uncomment and duplicate this block for each database you want to purge.
# The binding name MUST match purgeConfig.d1[].bindingName in config.ts exactly.
# ---------------------------------------------------------------------------
# [[d1_databases]]
# binding     = "REPLACE_ME_D1_BINDING"   # e.g. "MY_APP_DB"
# database_id = "REPLACE_ME_WITH_DATABASE_ID"
