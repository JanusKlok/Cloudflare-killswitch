{
  "name": "cloudflare-killswitch",
  "version": "1.0.0",
  "description": "Cloudflare Worker that monitors free-tier usage every 5 minutes and automatically blocks all traffic when any limit is breached.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.26.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "wrangler dev",
    "validate": "tsx scripts/validate-config.ts",
    "deploy": "tsx scripts/validate-config.ts && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.20",
    "@cloudflare/workers-types": "4.20260626.1",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "wrangler": "4.105.0"
  }
}
